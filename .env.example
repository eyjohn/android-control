# Firebase Configuration
FIREBASE_DATABASE_URL=https://<your-project>-default-rtdb.firebaseio.com
FIREBASE_API_KEY=<your-firebase-web-api-key>
FIREBASE_WEB_CLIENT_ID=<your-web-client-id>.apps.googleusercontent.com

# Coturn TURN Server Credentials (Host only)
TURN_SERVER=turn:<ip>:3478?transport=udp,turn:<ip>:3478?transport=tcp
TURN_USERNAME=turnuser
TURN_PASSWORD=<password>
TURN_REALM=experimentation-turn
